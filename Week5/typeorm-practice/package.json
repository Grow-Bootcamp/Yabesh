{
  "name": "typeorm-practice",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon --exec tsx src/app.ts",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "seed": "tsx src/seeders/user.seeder.ts",

    "migration:create": "npm run typeorm -- migration:create",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run --dataSource src/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show --dataSource src/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert --dataSource src/data-source.ts"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "mysql2": "^3.24.5",
    "nodemon": "^3.1.14",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.15",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
